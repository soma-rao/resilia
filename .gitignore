.gradle
**/build/
!**/src/**/build/

# MacOS
.DS_Store

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ IDEA
.idea/
*.iml
.settings/

# VS Code
.vscode/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Maven and Java
target/
*.class
*.log
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# Vaadin Build and dependency directories
node_modules/

# Vaadin frontend generated files
frontend/generated/
src/main/frontend/generated/
vite.generated.ts
webpack.generated.js
pnpmfile.js
.vaadin-node-tasks.lock

# Vaadin Production bundles (if not meant to be shared via git)
dev-bundle/
src/main/dev-bundle/

# Vaadin Testbench / Local Integration Testing
drivers/
error-screenshots/